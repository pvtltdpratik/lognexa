# Lognexa agent environment file (Linux: /etc/lognexa/agent.env).
# Only the enrolment token lives here, and only until first enrolment; afterwards
# the agent stores a per-device credential under its data directory and the token
# can be removed.
LOGNEXA_SERVER_URL=https://lognexa.example.com:8000
LOGNEXA_ENROLL_TOKEN=lnx_replace-with-a-token-from-the-dashboard
# Optional: path to a CA bundle if the server uses a private CA.
# LOGNEXA_AGENT_CA_BUNDLE=/etc/lognexa/ca.pem
