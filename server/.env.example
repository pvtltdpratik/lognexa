# Copy to .env and adjust. Never commit the real .env file.
# Variables are prefixed with LOGNEXA_ so a global DATABASE_URL from another project is never picked up.

# PostgreSQL (recommended / required for the final deployment)
LOGNEXA_DATABASE_URL=postgresql+psycopg2://lognexa:change-me@localhost:5432/lognexa

# Quick local fallback without PostgreSQL (development only):
# LOGNEXA_DATABASE_URL=sqlite:///./lognexa_dev.db

# Comma-separated list of origins allowed to call the API (the Next.js dev server)
LOGNEXA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Reproducibility seed for the synthetic dataset and Isolation Forest
LOGNEXA_RANDOM_SEED=42

# --- Endpoint monitoring (v2) ---
# Bearer tokens for dashboard users. Leave blank to disable endpoint APIs.
# Generate strong random values, e.g.: python -c "import secrets;print(secrets.token_urlsafe(32))"
LOGNEXA_ADMIN_TOKEN=
LOGNEXA_ANALYST_TOKEN=
# Require HTTPS for agent traffic (loopback is always allowed). Keep true in production.
LOGNEXA_AGENT_REQUIRE_HTTPS=true
# Set true only when behind a trusted TLS-terminating reverse proxy.
LOGNEXA_TRUST_PROXY_HEADERS=false
# Minimum endpoint risk score (1-100) that raises an endpoint alert.
LOGNEXA_ENDPOINT_ALERT_THRESHOLD=50
